{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Matchup notebook",
  "version": "0.1.0",
  "identifier": "com.jesse.matchupnotebook",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Matchup notebook",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://ddragon.leagueoflegends.com; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://ddragon.leagueoflegends.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGNzM2NkZDN0Q0MzdCQjUKUldTMWUwTjkvR1p6ZndPR3c3NmVicm1VdW9oYkxaSndUZ2tzQXFJenhQZmZLN2t6YThPcm9hUUwK",
      "endpoints": [
        "https://github.com/JesseVanWoudenberg/MatchupNotebook/releases/latest/download/latest.json"
      ]
    }
  }
}
